{
  "rules": {
    ".read": false,
    ".write": false,
    "devices": {
      "esp32s-30p-01": {
        "telemetry": {
          ".read": "auth != null && (auth.uid === 'OWNER_UID_HERE' || auth.uid === 'DEVICE_UID_HERE' || root.child('operators').child(auth.uid).val() === true)",
          ".write": "auth != null && auth.uid === 'DEVICE_UID_HERE'",
          ".validate": "newData.hasChildren(['flameDetected', 'gasAlarm', 'fanOn', 'updatedAt']) && newData.child('flameDetected').isBoolean() && newData.child('gasAlarm').isBoolean() && newData.child('fanOn').isBoolean() && newData.child('updatedAt').isNumber() && newData.child('updatedAt').val() <= now + 5000 && newData.child('updatedAt').val() >= now - 30000 && (!newData.child('temperatureC').exists() || (newData.child('temperatureC').isNumber() && newData.child('temperatureC').val() >= -40 && newData.child('temperatureC').val() <= 80)) && (!newData.child('humidityPct').exists() || (newData.child('humidityPct').isNumber() && newData.child('humidityPct').val() >= 0 && newData.child('humidityPct').val() <= 100))",
          "alarmLedOn": {
            ".validate": "newData.isBoolean()"
          },
          "statusLedOn": {
            ".validate": "newData.isBoolean()"
          },
          "buzzerOn": {
            ".validate": "newData.isBoolean()"
          },
          "fanSpeedSupported": {
            ".validate": "newData.isBoolean()"
          },
          "alarmLedMode": {
            ".validate": "newData.val() === 'auto' || newData.val() === 'on' || newData.val() === 'off'"
          },
          "statusLedMode": {
            ".validate": "newData.val() === 'auto' || newData.val() === 'on' || newData.val() === 'off'"
          },
          "buzzerMode": {
            ".validate": "newData.val() === 'auto' || newData.val() === 'on' || newData.val() === 'off'"
          },
          "controlsVersion": {
            ".validate": "newData.val() === 2"
          },
          "wifiConfigVersion": {
            ".validate": "newData.val() === 1"
          },
          "wifiSsid": {
            ".validate": "newData.isString() && newData.val().length <= 32"
          },
          "wifiChangeId": {
            ".validate": "newData.isString() && newData.val().length <= 64"
          },
          "wifiChangeStatus": {
            ".validate": "newData.val() === 'connecting' || newData.val() === 'applied' || newData.val() === 'failed'"
          },
          "muteUntil": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= now + 35000"
          },
          "appliedCommandId": {
            ".validate": "newData.isString() && newData.val().length <= 64"
          },
          "flameDetected": {
            ".validate": "newData.isBoolean()"
          },
          "gasAlarm": {
            ".validate": "newData.isBoolean()"
          },
          "fanOn": {
            ".validate": "newData.isBoolean()"
          },
          "updatedAt": {
            ".validate": "newData.isNumber()"
          },
          "temperatureC": {
            ".validate": "newData.isNumber() && newData.val() >= -40 && newData.val() <= 80"
          },
          "humidityPct": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          },
          "gasRaw": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4095"
          },
          "fanSpeedPct": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          },
          "fanReason": {
            ".validate": "newData.val() === 'gas' || newData.val() === 'purge' || newData.val() === 'manual' || newData.val() === 'blocked' || newData.val() === 'off'"
          },
          "logicVersion": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000"
          },
          "gasWarmup": {
            ".validate": "newData.isBoolean()"
          },
          "flameNoise": {
            ".validate": "newData.isBoolean()"
          },
          "flameGlitches": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "uptimeS": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "hardwareId": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9A-F]{12}$/)"
          },
          "resetReason": {
            ".validate": "newData.isString() && newData.val().length <= 16"
          },
          "$other": {
            ".validate": false
          }
        },
        "commands": {
          ".read": "auth != null && (auth.uid === 'OWNER_UID_HERE' || auth.uid === 'DEVICE_UID_HERE')",
          "fanOn": {
            ".write": "(auth != null && (auth.uid === 'OWNER_UID_HERE' || root.child('operators').child(auth.uid).val() === true)) && newData.exists()",
            ".validate": "newData.isBoolean()"
          },
          "fanSpeedPct": {
            ".write": "(auth != null && (auth.uid === 'OWNER_UID_HERE' || root.child('operators').child(auth.uid).val() === true)) && newData.exists()",
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100 && newData.val() % 1 === 0"
          },
          "muteRequestedAt": {
            ".write": "(auth != null && (auth.uid === 'OWNER_UID_HERE' || root.child('operators').child(auth.uid).val() === true)) && newData.exists()",
            ".validate": "newData.isNumber() && newData.val() >= now - 5000 && newData.val() <= now"
          },
          "commandId": {
            ".write": "(auth != null && (auth.uid === 'OWNER_UID_HERE' || root.child('operators').child(auth.uid).val() === true)) && newData.exists()",
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64 && newData.val().matches(/^[A-Za-z0-9_-]+$/)"
          },
          "alarmLedMode": {
            ".write": "(auth != null && (auth.uid === 'OWNER_UID_HERE' || root.child('operators').child(auth.uid).val() === true)) && newData.exists()",
            ".validate": "newData.val() === 'auto' || newData.val() === 'on' || newData.val() === 'off'"
          },
          "statusLedMode": {
            ".write": "(auth != null && (auth.uid === 'OWNER_UID_HERE' || root.child('operators').child(auth.uid).val() === true)) && newData.exists()",
            ".validate": "newData.val() === 'auto' || newData.val() === 'on' || newData.val() === 'off'"
          },
          "buzzerMode": {
            ".write": "(auth != null && (auth.uid === 'OWNER_UID_HERE' || root.child('operators').child(auth.uid).val() === true)) && newData.exists()",
            ".validate": "newData.val() === 'auto' || newData.val() === 'on' || newData.val() === 'off'"
          },
          "wifi": {
            ".write": "auth != null && ((auth.uid === 'OWNER_UID_HERE' && newData.exists()) || (auth.uid === 'DEVICE_UID_HERE' && !newData.exists()))",
            ".validate": "newData.hasChildren(['requestId', 'ssid', 'password'])",
            "requestId": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64 && newData.val().matches(/^[A-Za-z0-9_-]+$/)"
            },
            "ssid": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 32"
            },
            "password": {
              ".validate": "newData.isString() && newData.val().length >= 8 && newData.val().length <= 63"
            },
            "$other": {
              ".validate": false
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "operators": {
      ".read": "auth != null && auth.uid === 'OWNER_UID_HERE'",
      "$uid": {
        ".read": "auth != null && (auth.uid === 'OWNER_UID_HERE' || auth.uid === $uid)",
        ".write": "auth != null && auth.uid === 'OWNER_UID_HERE'",
        ".validate": "newData.isBoolean()"
      }
    },
    "operatorProfiles": {
      ".read": "auth != null && auth.uid === 'OWNER_UID_HERE'",
      "$uid": {
        ".write": "auth != null && auth.uid === 'OWNER_UID_HERE'",
        ".validate": "newData.hasChildren(['email', 'createdAt'])",
        "email": {
          ".validate": "newData.isString() && newData.val().length > 3 && newData.val().length <= 254"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= now + 5000"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
